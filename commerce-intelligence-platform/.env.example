# ==============================================================================
# MAGRABI COMMERCE INTELLIGENCE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide credentials to activate live data feeds.
# All connectors are strictly read-only.
# ==============================================================================

# Server Runtime Settings
PORT=5174
NODE_ENV=production
CONNECTOR_TIMEOUT_MS=12000
# Comma-separated browser origins only when cross-origin access is intentionally required.
# Leave blank for same-origin access only.
CORS_ALLOWED_ORIGINS=

# Dashboard login. For local setup, run `npm run auth:configure` to store values
# under the gitignored workspace .secrets directory. Deploy these as secret env vars.
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD_HASH=
AUTH_VIEWER_USERNAME=
AUTH_VIEWER_PASSWORD_HASH=
AUTH_MANAGED_USERS_FILE=
AUTH_SESSION_SECRET=
AUTH_SESSION_TIMEOUT_MINUTES=10

# ------------------------------------------------------------------------------
# 1. SALEOR CORE (E-Commerce Platform)
# ------------------------------------------------------------------------------
# GraphQL API endpoint for orders, channels, checkout and payment statuses
SALEOR_GRAPHQL_URL=https://ecom-app-api.magrabi.com/graphql/
SALEOR_DASHBOARD_URL=https://ecom-app.magrabi.com/dashboard/
SALEOR_USERNAME=
SALEOR_PASSWORD=
SALEOR_CACHE_TTL=60
# Bounded pagination for exact revenue/detail aggregation (100 orders per page).
SALEOR_MAX_REVENUE_PAGES=250

# ------------------------------------------------------------------------------
# 2. MACULA OMS (Order Management System)
# ------------------------------------------------------------------------------
# Order search endpoint and credentials for fulfillment and reconciliation
MACULA_API_URL=https://macula-api.magrabi.com/api/v1/order/search
MACULA_DASHBOARD_URL=https://macula-v2.magrabi.com/login
MACULA_USERNAME=
MACULA_PASSWORD=
# Direct service token (if provided by OMS team instead of username/password)
MACULA_TOKEN=

# ------------------------------------------------------------------------------
# 3. DIRECT PAYMENT GATEWAY APIS (Optional / Direct Reporting Feeds)
# ------------------------------------------------------------------------------
# Checkout.com (UAE, KSA, Card & Apple Pay reporting)
CHECKOUT_API_URL=https://api.checkout.com
CHECKOUT_SECRET_KEY=
CHECKOUT_PROCESSING_CHANNEL_ID=
# Checkout.com has no assumed list-payments contract. Set only to an approved read-only report path.
CHECKOUT_REPORT_PATH=

# Tabby (BNPL merchant inquiry API)
TABBY_API_URL=https://api.tabby.ai/api/v2
TABBY_SECRET_KEY=
TABBY_REPORT_PATH=/payments

# Tamara (BNPL merchant inquiry API)
TAMARA_API_URL=https://api.tamara.co
TAMARA_API_TOKEN=
TAMARA_REPORT_PATH=/orders

# Paymob (Egypt cards and mobile wallets)
PAYMOB_API_URL=https://accept.paymob.com/api
PAYMOB_API_KEY=
# Set only to an approved GET-only reporting path for the merchant account.
PAYMOB_REPORT_PATH=

# ------------------------------------------------------------------------------
# 4. AZURE FRONT DOOR & EDGE MONITORING (Optional)
# ------------------------------------------------------------------------------
# Azure Monitor REST API for edge request counts and 2xx/3xx/4xx/5xx status codes
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=72bde893-fa26-4129-a31f-648b81a48153
AZURE_RESOURCE_GROUP=rg-mepu-common-uaenorth-001
AZURE_FRONTDOOR_PROFILE=frontdoor-mepu-common-uaenorth-001
AZURE_MONITOR_METRIC_NAMES=RequestCount,ClientLatency

# ------------------------------------------------------------------------------
# 5. OBSERVABILITY & APM (Grafana / Prometheus / AKS) (Optional)
# ------------------------------------------------------------------------------
# Production ECom Grafana & Macula Grafana
ECOM_GRAFANA_URL=https://grafana.test-magrabi.com
ECOM_GRAFANA_USER=
ECOM_GRAFANA_PASSWORD=
ECOM_GRAFANA_TOKEN=
PROMETHEUS_DATASOURCE_UID=
# PromQL supplied by the observability owner. Health reachability alone does not provide metrics.
GRAFANA_LATENCY_QUERY=
GRAFANA_CPU_QUERY=
GRAFANA_MEMORY_QUERY=

MACULA_GRAFANA_URL=
MACULA_GRAFANA_USER=
MACULA_GRAFANA_PASSWORD=

# ------------------------------------------------------------------------------
# 6. GOOGLE ANALYTICS 4 + MICROSOFT CLARITY (Read-only, optional)
# ------------------------------------------------------------------------------
# GA4: use a service account with Analytics Viewer access to each property.
# Keep the full service-account JSON private and server-side. Do not use a Google
# account password or place these values in browser/Vite variables.
GA4_SERVICE_ACCOUNT_JSON=
# Up to two separate GA4 properties. Use property IDs and dashboard labels.
# Example shape only: [{"id":"000000000","label":"Magrabi Store","timezone":"Asia/Dubai"},{"id":"000000001","label":"DoctorM Store","timezone":"Asia/Riyadh"}]
GA4_PROPERTIES=
GA4_CACHE_TTL_SECONDS=300

# Clarity: each token is scoped to a project. No raw session or URL data is shown.
# Example shape only: [{"label":"Magrabi Store","token":"REPLACE_LOCALLY"},{"label":"DoctorM Store","token":"REPLACE_LOCALLY"}]
CLARITY_PROJECTS=
# Clarity allows 10 requests/project/day; default cache is 24 hours.
CLARITY_CACHE_TTL_SECONDS=86400

# ------------------------------------------------------------------------------
# 7. INCIDENT ALERTS & NOTIFICATIONS (Optional)
# ------------------------------------------------------------------------------
# Microsoft Teams Incoming Webhook URL
TEAMS_WEBHOOK_URL=

# Email SMTP / Graph Mail Relay
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENTS=
# Safety gate. Keep false for dashboard simulation and connectivity work.
ALERT_DELIVERY_ENABLED=false

# ------------------------------------------------------------------------------
# 8. COMMERCE ASSIST (Optional natural-language enhancement)
# ------------------------------------------------------------------------------
# The assistant works without a key using the built-in platform answer engine.
# Use a Gemini API key from Google AI Studio. Keep the key server-side.
# The assistant never enables web search or access to out-of-platform sources.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
ASSISTANT_MAX_HISTORY=8
